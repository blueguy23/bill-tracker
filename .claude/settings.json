{
  "permissions": {
    "allow": [
      "Bash(gh run view:*)",
      "Bash(gh api repos/*)",
      "Bash(gh run watch:*)",
      "Bash(docker logs:*)",
      "Bash(gh run list:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(docker ps:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm test:unit:*)",
      "Bash(pnpm test:coverage:*)",
      "Bash(pnpm test:integration:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/garci/projects/bill-tracker/.claude/hooks/block-secrets.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/garci/projects/bill-tracker/.claude/hooks/check-rybbit.sh"
          },
          {
            "type": "command",
            "command": "bash /home/garci/projects/bill-tracker/.claude/hooks/check-branch.sh"
          },
          {
            "type": "command",
            "command": "bash /home/garci/projects/bill-tracker/.claude/hooks/check-ports.sh"
          },
          {
            "type": "command",
            "command": "bash /home/garci/projects/bill-tracker/.claude/hooks/check-e2e.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/garci/projects/bill-tracker/.claude/hooks/lint-on-save.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/garci/projects/bill-tracker/.claude/hooks/lint-on-save.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/garci/projects/bill-tracker/.claude/hooks/verify-no-secrets.sh"
          },
          {
            "type": "command",
            "command": "bash /home/garci/projects/bill-tracker/.claude/hooks/check-rulecatch.sh"
          },
          {
            "type": "command",
            "command": "bash /home/garci/projects/bill-tracker/.claude/hooks/check-env-sync.sh"
          }
        ]
      }
    ]
  }
}